#!/bin/sh
# Starts sway from GDM's "Sway" entry. Lives in ~/.dots/.bootstrap;
# install.sh installs it to /usr/local/bin (the stock sway.desktop is
# overridden in /usr/local/share/wayland-sessions).
#
# On a plain Intel/AMD machine this is just `exec sway`. With the
# proprietary NVIDIA driver loaded, sway needs --unsupported-gpu, and on
# this hybrid laptop it must use ONE GPU per session: rendering on NVIDIA
# and scanning out on Intel's eDP-1 needs cross-GPU buffer copies, which
# fail here (eDP-1's modeset fails, sway drops it, black screen). So:
#   docked (a display connected to an NVIDIA port) -> NVIDIA only
#   otherwise                                       -> Intel only
# Plugging/unplugging the dock mid-session therefore needs a re-login.
# The /dev/dri/*-card names come from 99-dri-gpu-names.rules (cardN
# numbering isn't stable across boots, and by-path names contain ':',
# which WLR_DRM_DEVICES can't take).
set -eu

# $1: /dev/dri/<x>-card symlink; true if any of that card's connectors
# reports a connected display.
has_display() {
    [ -e "$1" ] || return 1
    card=$(basename "$(readlink -f "$1")")
    for s in /sys/class/drm/"$card"-*/status; do
        [ "$(cat "$s" 2>/dev/null)" = connected ] && return 0
    done
    return 1
}

if [ -d /sys/module/nvidia_drm ]; then
    set -- --unsupported-gpu "$@"
    if has_display /dev/dri/nvidia-card; then
        export WLR_DRM_DEVICES=/dev/dri/nvidia-card
    elif [ -e /dev/dri/intel-card ]; then
        export WLR_DRM_DEVICES=/dev/dri/intel-card
    fi
fi

# GDM throws the session's stderr away, so a sway that dies at startup
# otherwise leaves no trace. Previous session's log kept as sway.log.old.
log="${XDG_STATE_HOME:-$HOME/.local/state}/sway.log"
mkdir -p "$(dirname "$log")"
[ -f "$log" ] && mv -f "$log" "$log.old"
echo "WLR_DRM_DEVICES=${WLR_DRM_DEVICES:-} args: $*" >"$log"
# Not exec'd: if sway dies within SWAY_SESSION_FAST_FAIL seconds it never
# really started (bad config, driver trouble), so try once more with the
# distro's stock config — its own bar, a terminal on $mod+Return — to
# get a session to fix things from. A second failure returns to GDM,
# where GNOME is still there.
fast_fail="${SWAY_SESSION_FAST_FAIL:-10}"
safe_config="${SWAY_SESSION_SAFE_CONFIG:-/etc/sway/config}"
started=$(date +%s)
status=0
sway "$@" 2>>"$log" || status=$?
[ "$status" -eq 0 ] && exit 0
if [ $(($(date +%s) - started)) -ge "$fast_fail" ]; then
    exit "$status"
fi
echo "sway exited ($status) within ${fast_fail}s; retrying in safe mode with $safe_config" >>"$log"
exec sway -c "$safe_config" "$@" 2>>"$log"
