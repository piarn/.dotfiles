# git
abbr -a g git
abbr -a ga 'git add'
abbr -a gaa 'git add --all'
abbr -a gc 'git commit'
abbr -a gcm 'git commit -m'
abbr -a gco 'git checkout'
abbr -a gcb 'git checkout -b'
abbr -a gst 'git status'
abbr -a gd 'git diff'
abbr -a gl 'git log --oneline --graph --decorate'
abbr -a gp 'git push'
abbr -a gpl 'git pull'
abbr -a gb 'git branch'

# navigation
abbr -a .. 'cd ..'
abbr -a ... 'cd ../..'

# misc
abbr -a c clear
abbr -a e $EDITOR
