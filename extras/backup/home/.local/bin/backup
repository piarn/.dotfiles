#!/usr/bin/env bash
# restic, with the repository and password from ~/.config/backup/env.
#
#   backup                  snapshot BACKUP_PATHS, then forget/prune old
#                           snapshots (what backup.timer runs daily)
#   backup init             create the repository (once)
#   backup <restic args>    anything else goes straight to restic:
#                           backup snapshots, backup restore latest --target /tmp/r
#                           --include ~/notes, backup mount ~/mnt, backup check
#
# A run that fails sends a notification, so a timer run that stopped
# working (disk not plugged in, host offline) doesn't go unnoticed.
set -euo pipefail

conf="$HOME/.config/backup"

fail() {
    echo "backup: $*" >&2
    command -v notify-send >/dev/null 2>&1 \
        && notify-send -u critical -a backup "Backup failed" "$*" || true
    exit 1
}

[ -f "$conf/env" ] || fail "no $conf/env; run ~/.dots/extras/extras.sh enable backup"
# shellcheck source=/dev/null
. "$conf/env"
[ -n "${RESTIC_REPOSITORY:-}" ] || fail "RESTIC_REPOSITORY isn't set in $conf/env"
export RESTIC_REPOSITORY RESTIC_PASSWORD_FILE

if [ $# -gt 0 ]; then
    exec restic "$@"
fi

# exit 3: the snapshot was saved, but some files couldn't be read (a
# socket, a file owned by root) — restic already listed them above
rc=0
restic backup "${BACKUP_PATHS[@]}" \
    --exclude-file "$conf/excludes" \
    --exclude-caches \
    --one-file-system \
    --tag auto || rc=$?
[ "$rc" -eq 0 ] || [ "$rc" -eq 3 ] \
    || fail "restic backup exited with $rc; see journalctl --user -u backup"

# Only the timer's own snapshots (--tag auto) age out; ones taken by hand
# with `backup backup ...` stay until removed by hand.
restic forget --prune --tag auto \
    --keep-daily "${KEEP_DAILY:-7}" \
    --keep-weekly "${KEEP_WEEKLY:-4}" \
    --keep-monthly "${KEEP_MONTHLY:-12}" \
    || fail "restic forget/prune failed; see journalctl --user -u backup"
