#!/usr/bin/env bash
# Keeps a NoInputNoOutput bluetooth agent registered for the whole session,
# and works around a wireplumber/bluez race that otherwise needs a manual
# fix after almost every reconnect.
#
# Problem 1: nothing here registers a bluetooth agent (no blueman/GNOME
# shell) — `bluetoothctl pair`/`connect` register one only for the life of
# that one-shot process. bluez then has no agent left to authorize the
# A2DP/AVRCP/HFP profile connections a headset negotiates right after the
# initial connect, and rejects them ("Authentication attempt without agent"
# / "Access denied: org.bluez.Error.Rejected" in `journalctl -u bluetooth`)
# — pairing succeeds but the device immediately drops, and whatever profile
# *did* half-negotiate before the rejection (often HSP/HFP, mono 16kHz)
# sticks as the only one pipewire ever offers, which is also why audio can
# come out sounding like a phone call instead of music.
#
# bluetoothctl only stays alive (and keeps its agent registered) as long as
# its stdin doesn't hit EOF, so it's fed from a `sleep infinity` pipe
# instead of run as a one-shot command.
#
# Problem 2: even with the agent fixed, wireplumber's bluez5 monitor can
# still fail to notice a device that just connected — bluetoothd reports
# Connected: yes, but no bluez_output.*/bluez_input.* node ever appears in
# `pactl list sinks/sources`, so it's invisible to both pavucontrol-style
# tools and this bar's volume/mic widgets. `systemctl --user restart
# wireplumber` reliably fixes this (it re-scans bluez from scratch) but
# doesn't happen on its own, so this watches bluetoothctl's own event
# stream for "Connected: yes" and nudges wireplumber a few seconds later —
# but only if the device still hasn't shown up by then, so the common case
# (it works fine on its own) never pays the restart cost.
set -euo pipefail

pgrep -x bluetoothctl >/dev/null 2>&1 && exit 0

check_device_appeared() {
    local mac="$1" norm
    norm=$(tr -d ':' <<<"$mac" | tr 'A-Z' 'a-z')
    sleep 4
    if { pactl list short sinks; pactl list short sources; } 2>/dev/null \
        | tr -d ':_' | tr 'A-Z' 'a-z' | grep -q "bluez.*${norm}"; then
        return
    fi
    systemctl --user try-restart wireplumber
}

{
    printf 'agent NoInputNoOutput\ndefault-agent\n'
    exec sleep infinity
} | stdbuf -oL bluetoothctl 2>&1 | while IFS= read -r line; do
    if [[ "$line" == *"Connected: yes"* ]]; then
        mac=$(sed -n 's/.*Device \([0-9A-Fa-f:]\{17\}\).*/\1/p' <<<"$line")
        [ -n "$mac" ] && check_device_appeared "$mac" &
    fi
done
