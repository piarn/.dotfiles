#!/bin/sh
# Pick a color off the screen: click a pixel (slurp), its #rrggbb goes to
# the clipboard and a notification. From quickshell's command center
# (tools). No image library needed: a binary PPM's last three bytes are
# the pixel.
g=$(slurp -p) || exit 0
hex=$(grim -g "$g" -t ppm - | tail -c 3 | od -An -tx1 | tr -d ' \n')
[ ${#hex} -eq 6 ] || exit 1
printf '#%s' "$hex" | wl-copy
notify-send -a color-pick "#$hex" "copied to the clipboard"
