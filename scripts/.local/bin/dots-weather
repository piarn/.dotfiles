#!/usr/bin/env python3
"""Fetch the current weather for one fixed city into a cache file.

Run by dots-weather.timer (every 30 minutes). quickshell's WeatherState
only ever reads the cache, so the bar and the lock screen never wait on the
network, and a failed fetch leaves the last weather in place (the readers
hide it once it's over 3 hours old).

The city is set per machine in ~/.config/dots/weather.conf (`city=Vilnius`),
outside the repo; no city, nothing to do. Open-Meteo, no API key: the city
is geocoded once and its coordinates kept next to the cache.

DOTS_WEATHER_CONF, DOTS_WEATHER_CACHE, DOTS_WEATHER_GEO_URL and
DOTS_WEATHER_FORECAST_URL override paths and endpoints (tests/test-dots-weather.sh).
"""

import json
import os
import sys
import time
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path.home()
CONF = Path(os.environ.get("DOTS_WEATHER_CONF", HOME / ".config/dots/weather.conf"))
CACHE = Path(os.environ.get("DOTS_WEATHER_CACHE", HOME / ".cache/dots/weather.json"))
LOCATION = CACHE.with_name("weather-location.json")
GEO_URL = os.environ.get("DOTS_WEATHER_GEO_URL",
                         "https://geocoding-api.open-meteo.com/v1/search?count=1&name={city}")
FORECAST_URL = os.environ.get("DOTS_WEATHER_FORECAST_URL",
                              "https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}"
                              "&current=temperature_2m,weather_code,is_day")

# Material Symbols (the shell's icon font) codepoints, read from the font's
# ligatures rather than guessed.
SUN, MOON = "", ""
PARTLY_DAY, PARTLY_NIGHT = "", ""
CLOUD, FOG = "", ""
RAIN_LIGHT, RAIN, RAIN_HEAVY = "", "", ""
SNOW, MIX, GRAIN, STORM = "", "", "", ""

# WMO weather interpretation codes -> (description, day glyph, night glyph)
CODES = {
    0: ("clear", SUN, MOON),
    1: ("mostly clear", SUN, MOON),
    2: ("partly cloudy", PARTLY_DAY, PARTLY_NIGHT),
    3: ("overcast", CLOUD, CLOUD),
    45: ("fog", FOG, FOG),
    48: ("rime fog", FOG, FOG),
    51: ("light drizzle", RAIN_LIGHT, RAIN_LIGHT),
    53: ("drizzle", RAIN_LIGHT, RAIN_LIGHT),
    55: ("heavy drizzle", RAIN, RAIN),
    56: ("freezing drizzle", MIX, MIX),
    57: ("freezing drizzle", MIX, MIX),
    61: ("light rain", RAIN_LIGHT, RAIN_LIGHT),
    63: ("rain", RAIN, RAIN),
    65: ("heavy rain", RAIN_HEAVY, RAIN_HEAVY),
    66: ("freezing rain", MIX, MIX),
    67: ("freezing rain", MIX, MIX),
    71: ("light snow", SNOW, SNOW),
    73: ("snow", SNOW, SNOW),
    75: ("heavy snow", SNOW, SNOW),
    77: ("snow grains", GRAIN, GRAIN),
    80: ("light showers", RAIN_LIGHT, RAIN_LIGHT),
    81: ("showers", RAIN, RAIN),
    82: ("heavy showers", RAIN_HEAVY, RAIN_HEAVY),
    85: ("snow showers", SNOW, SNOW),
    86: ("snow showers", SNOW, SNOW),
    95: ("thunderstorm", STORM, STORM),
    96: ("thunderstorm, hail", STORM, STORM),
    99: ("thunderstorm, hail", STORM, STORM),
}


def fetch(url: str) -> dict:
    with urllib.request.urlopen(url, timeout=15) as r:
        return json.load(r)


def configured_city() -> str:
    try:
        for line in CONF.read_text().splitlines():
            key, _, value = line.partition("=")
            if key.strip() == "city" and value.strip():
                return value.strip()
    except FileNotFoundError:
        pass
    return ""


def location(city: str) -> dict:
    """The city's coordinates, geocoded once and cached."""
    try:
        cached = json.loads(LOCATION.read_text())
        if cached.get("query") == city:
            return cached
    except (FileNotFoundError, ValueError):
        pass
    results = fetch(GEO_URL.format(city=urllib.parse.quote(city))).get("results") or []
    if not results:
        sys.exit(f"dots-weather: city {city!r} not found")
    r = results[0]
    loc = {"query": city, "name": r["name"], "lat": r["latitude"], "lon": r["longitude"]}
    write_atomic(LOCATION, loc)
    return loc


def write_atomic(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False))
    tmp.replace(path)


def main() -> None:
    city = configured_city()
    if not city:
        print(f"dots-weather: no city set in {CONF} (city=...); nothing to do")
        return
    loc = location(city)
    try:
        current = fetch(FORECAST_URL.format(lat=loc["lat"], lon=loc["lon"]))["current"]
    except (OSError, ValueError, KeyError) as e:
        sys.exit(f"dots-weather: forecast fetch failed ({e}); keeping the last one")
    code = int(current["weather_code"])
    desc, day, night = CODES.get(code, ("unknown", CLOUD, CLOUD))
    write_atomic(CACHE, {
        "city": loc["name"],
        "temp": round(current["temperature_2m"]) + 0,  # + 0: no "-0"
        "code": code,
        "desc": desc,
        "glyph": day if current.get("is_day", 1) else night,
        "updated": int(time.time()),
    })


if __name__ == "__main__":
    main()
