#!/usr/bin/env python3
"""Render a blurred screenshot per connected sway output for the quickshell
lock screen (~/.dots/quickshell/.config/quickshell/popups/LockScreen.qml).

Run detached the moment the screen locks (the lock itself is instant —
this just fills in the background a beat later once it's ready). Writes
one PNG per output, named after the output, to
$XDG_RUNTIME_DIR/quickshell-lock/<output>.png. LockScreen.qml matches each
WlSessionLockSurface to its file by screen.name and falls back to a plain
black background if grim/magick are missing or a given output's capture
fails, same fallback lockscreen (its predecessor) used.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

OUT_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "quickshell-lock"


def have(cmd: str) -> bool:
    return subprocess.run(["sh", "-c", f"command -v {cmd}"], capture_output=True).returncode == 0


def main() -> None:
    if not (have("grim") and have("magick")):
        return

    try:
        outputs = json.loads(subprocess.run(
            ["swaymsg", "-t", "get_outputs", "-r"], capture_output=True, text=True, check=True
        ).stdout)
    except (subprocess.CalledProcessError, json.JSONDecodeError):
        return

    OUT_DIR.mkdir(parents=True, exist_ok=True)

    for output in outputs:
        if not output.get("active"):
            continue
        name = output["name"]
        dest = OUT_DIR / f"{name}.png"
        tmp = OUT_DIR / f".{name}.png.tmp"
        if subprocess.run(["grim", "-o", name, str(tmp)], capture_output=True).returncode != 0:
            continue
        subprocess.run(
            ["magick", str(tmp), "-scale", "10%", "-blur", "0x5", "-scale", "1000%", str(tmp)],
            capture_output=True,
        )
        tmp.replace(dest)  # atomic swap — LockScreen.qml never sees a half-written file


if __name__ == "__main__":
    main()
