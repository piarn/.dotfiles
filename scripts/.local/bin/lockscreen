#!/usr/bin/env bash
# Lock the screen with a blurred screenshot as the background, if grim and
# magick are available; otherwise falls back to a plain swaylock.
# Indicator/text/ring colors come from ~/.config/swaylock/config (Toxic
# theme, see ~/.rice/swaylock).
set -euo pipefail

if command -v grim >/dev/null && command -v magick >/dev/null; then
    tmp="$(mktemp --suffix=.png)"
    trap 'rm -f "$tmp"' EXIT

    grim "$tmp"
    magick "$tmp" -scale 10% -blur 0x5 -scale 1000% "$tmp"

    swaylock --ignore-empty-password -i "$tmp"
else
    swaylock --ignore-empty-password
fi
