#!/bin/sh
# Runs the session's polkit authentication agent: the password prompt for
# privileged actions (NetworkManager/bluetooth changes, pkexec, disk tools),
# which otherwise fail silently. Started by polkit-agent.service.
#
# install.sh installs mate-polkit — the one agent packaged under the same
# name on Fedora, Debian/Ubuntu and Arch (Fedora dropped polkit-gnome) — but
# each distro puts the binary somewhere else, and none of them on PATH.
for agent in \
    /usr/libexec/polkit-mate-authentication-agent-1 \
    /usr/lib/mate-polkit/polkit-mate-authentication-agent-1 \
    /usr/libexec/polkit-gnome-authentication-agent-1 \
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
    /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1; do
    [ -x "$agent" ] && exec "$agent"
done
echo "polkit-agent: no polkit agent installed (install mate-polkit)" >&2
exit 1
