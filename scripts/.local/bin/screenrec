#!/bin/sh
# Screen recorder toggle, bound to $mod+Shift+r in sway.
#
# Not recording: slurp picks what to record — click a window, drag a
# region, or click a monitor's bar/empty space for all of it — and
# wf-recorder records it to
# ~/Videos/Captures/ as H.264, hardware-encoded through VAAPI (falls
# back to x264 if that fails to start). Recording: stops it (SIGINT, so
# the mp4 gets finalised), then notifies and puts the file on the
# clipboard as a file URI — pastes as an attachment into Slack/Jira/
# browsers.
#
# $XDG_RUNTIME_DIR/screenrec.state holds "<pid> <start epoch>" while
# recording and is empty otherwise; quickshell watches it for the bar's
# REC indicator (state/RecorderState.qml), which also stops it on click.
#
# No audio by default; `screenrec --audio` records the default mic too.
state="${XDG_RUNTIME_DIR:-/tmp}/screenrec.state"
dir="$HOME/Videos/Captures"

read -r pid _ 2>/dev/null <"$state"
if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill -INT "$pid"
    exit 0
fi

if ! command -v wf-recorder >/dev/null 2>&1; then
    notify-send -a screenrec -u critical "Can't record" "wf-recorder isn't installed (sudo apt install wf-recorder)"
    exit 1
fi
pgrep -x slurp >/dev/null && exit 0

# Visible windows as clickable boxes for slurp (content area, without
# title bar/border); -o adds whole outputs. A window "capture" is really
# its screen area: whatever covers it gets recorded too, and it isn't
# followed if moved — sway 1.9 has no per-window capture.
windows() {
    swaymsg -t get_tree | python3 -c '
import json, sys
def walk(n):
    if n.get("pid") and n.get("visible"):
        r, w = n["rect"], n["window_rect"]
        print("%d,%d %dx%d" % (r["x"] + w["x"], r["y"] + w["y"], w["width"], w["height"]))
    for c in n.get("nodes", []) + n.get("floating_nodes", []):
        walk(c)
walk(json.load(sys.stdin))'
}
region=$(windows | slurp -o) || exit 0

# H.264 needs even dimensions; slurp happily returns odd ones.
region=$(printf '%s\n' "$region" | awk '{
    split($1, p, ","); split($2, s, "x")
    printf "%d,%d %dx%d", p[1], p[2], s[1] - s[1] % 2, s[2] - s[2] % 2
}')

mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).mp4"
audio=
[ "$1" = --audio ] && audio=--audio

record() {
    wf-recorder -g "$region" -f "$file" $audio "$@" </dev/null >/dev/null 2>&1 &
    pid=$!
    printf '%s %s\n' "$pid" "$(date +%s)" >"$state"
    wait "$pid"
}

record -c h264_vaapi -d /dev/dri/renderD128
status=$?
# VAAPI failing shows up as an immediate exit with no usable file.
if [ ! -s "$file" ]; then
    rm -f "$file"
    record -c libx264 -p preset=veryfast -p crf=23
    status=$?
fi
: >"$state"

if [ -s "$file" ]; then
    printf 'file://%s\n' "$file" | wl-copy -t text/uri-list
    notify-send -a screenrec -i video-x-generic "Recording saved" \
        "$(basename "$file") — copied to clipboard"
else
    rm -f "$file"
    notify-send -a screenrec -u critical "Recording failed" "wf-recorder exited with $status"
fi
