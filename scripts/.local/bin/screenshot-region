#!/bin/sh
# Region screenshot, bound to $mod+Shift+s in sway. grim grabs the focused
# monitor and satty opens it fullscreen with the crop tool picked, so the
# screen is frozen while you drag out the region: Enter saves + copies the
# cropped area (see ~/.rice/satty), Esc cancels. Other tools (arrows,
# blur, text, ...) stay available on top of the crop.
#
# -l 0: uncompressed PNG, ~80ms instead of ~260ms for a 1080p capture; it
# only goes through the pipe, satty compresses what it saves.
output=$(swaymsg -t get_outputs -p | awk '/^Output / && /\(focused\)/ {print $2}')
grim -l 0 ${output:+-o "$output"} - |
    "$HOME/.local/bin/satty" --filename - --fullscreen --initial-tool crop
