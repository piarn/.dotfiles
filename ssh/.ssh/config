# Hosts that don't belong in a public repo (home server, work machines):
# first match wins, so these take precedence over anything below.
Include ~/.ssh/config.local

# Load each key into the session agent (ssh-agent.service) the first time
# it's used, so a passphrase is asked for once per boot, not once per shell.
Host *
    AddKeysToAgent yes

# Keys live in ~/.ssh/keys/, which ssh never looks in by itself.
Host github.com
    IdentityFile ~/.ssh/keys/github
    IdentitiesOnly yes

Host git.provly.eu
    IdentityFile ~/.ssh/keys/git_provly
    IdentitiesOnly yes
