# sway — see `man 5 sway`. Colors, gaps and screen layout come from ~/.rice.

### Variables
#
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Cursor theme — without this, nothing sets XCURSOR_THEME, and wlroots
# can't resolve the custom-cursor requests GTK/Chromium issue on
# image/canvas hover, so the pointer just disappears there instead of
# falling back to a default arrow. This sets wlroots' own cursor manager;
# see ~/.config/environment.d/cursor.conf for the env vars GTK/Xwayland
# apps need too (must be set before sway starts, so it can't live here).
seat seat0 xcursor_theme Adwaita 24
# Terminals — kitty is primary (live theme reload via
# reload_config_on_change), foot stays for quick/lightweight launches (see
# $mod+Shift+Return below) since it's the lighter of the two.
set $term kitty
set $term_fast foot
# File manager and browser (both flatpaks)
set $files flatpak run org.kde.dolphin
set $browser flatpak run org.mozilla.firefox
# quickshell's IPC client (the distro package)
set $qs $HOME/.local/bin/qs
# The command center (~/.dots/quickshell/.config/quickshell/popups/CommandCenter.qml):
# apps plus the prefix modes (=calc >run /files ?web @windows ~dev !tools :session).
set $menu exec $qs ipc call commandcenter toggle

### Theme (~/.rice)
include ~/.rice/sway/theme.conf

### Output configuration
#
output * bg ~/.rice/wallpaper.png fill
#
# Screen layout: ~/.rice/layouts/*.conf, switch manually with
# `apply-layout <name>` (e.g. apply-layout laptop) or let it auto-detect
# with `apply-layout --auto`. Rendered here by apply-layout from the
# active profile.
include ~/.rice/sway/outputs.conf
#
# Session services — layout-watch (auto-switch the screen layout on
# dock/undock), bluetooth-agent (pairing agent), the polkit agent (password
# prompts for privileged actions), cliphist (clipboard history for $mod+v),
# udiskie (USB automount), swayidle (lock after 10 minutes idle and before
# any suspend/lid close, never suspend on its own) and qs-watchdog — run as
# systemd user services under dots-session.target
# (~/.config/systemd/user), so a crash gets them restarted and their logs
# land in `journalctl --user -u <name>`.
#
# Importing WAYLAND_DISPLAY/SWAYSOCK into the systemd user environment
# first is what lets them reach this sway. It also makes screen sharing
# (Meet/Teams/Zoom in the browser) work: xdg-desktop-portal only reads
# ~/.config/xdg-desktop-portal/sway-portals.conf, which routes ScreenCast to
# the wlr backend, when XDG_CURRENT_DESKTOP is in that environment, and the
# portal may already have started without it, hence its restart. `restart`
# (not `start`) on the target replaces services left over from a previous
# sway that crashed before it could stop them.
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK I3SOCK DISPLAY XDG_CURRENT_DESKTOP=sway && (systemctl --user restart xdg-desktop-portal || true) && systemctl --user restart dots-session.target
# ...and stop them when sway exits (Fedora's sway-systemd would do the
# same for its own target, Debian/Arch have nothing that would).
exec swaymsg -t subscribe '["shutdown"]' && systemctl --user stop dots-session.target

### Input configuration (`man 5 sway-input`)

input "type:keyboard" {
    xkb_layout "lt"
    xkb_variant "us"
}

### Key bindings
#
# One rule throughout: $mod+<letter> is the everyday action, named by its
# first letter where possible; $mod+Shift is the bigger version — move
# things, capture the screen, or system actions (reload, session).
# Nothing ends the session directly: logout sits behind the command
# center's `:` session rows, which ask for Enter twice.
# Plain Alt is left alone for apps (Firefox, nvim, tmux).
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term
    # Start the lightweight terminal (foot) for quick/throwaway launches
    bindsym $mod+Shift+Return exec $term_fast

    # Close (quit) the focused window
    bindsym $mod+q kill

    # The command center — apps plus the prefix modes (=calc >run /files
    # ?web @windows ~dev !tools :session). $mod+Space and $mod+d are the
    # same window; either key opens it.
    bindsym $mod+space exec $menu
    bindsym $mod+d exec $qs ipc call commandcenter toggle

    # Clipboard history picker (quickshell, fed by cliphist)
    bindsym $mod+v exec $qs ipc call clipboard toggle

    # File manager (explorer) and browser
    bindsym $mod+e exec $files
    bindsym $mod+b exec $browser

    # $mod+left drag moves, $mod+right drag resizes (tiled windows too)
    floating_modifier $mod normal

    # Reload the configuration file. Also kills quickshell first: its
    # exec_always line only spawns a new instance when none is running
    # (see the `-n` flag below), so a plain `reload` never picks up
    # changes to ~/.dots/quickshell's QML on its own — whether it does
    # depends on quickshell's own hot-reload, which isn't consistent
    # across versions/machines. SIGKILL rather than `qs kill`, which asks
    # over IPC and so can't stop a hung instance — this doubles as the
    # manual way out when a frozen popup is holding the keyboard/pointer.
    bindsym $mod+Shift+c exec pkill -KILL -x quickshell; reload

    # No dedicated exit-sway bind: logout lives in the command center's
    # `:` session mode.

    # Lock the screen — quickshell's own session-lock surface (Toxic-themed,
    # blurred screenshot background), see
    # ~/.dots/quickshell/.config/quickshell/popups/LockScreen.qml
    bindsym $mod+Escape exec $qs ipc call lock lock

    # The command center's `:` session mode (lock/reload/suspend/logout/
    # reboot/shutdown) — the deliberate next step up from the direct lock
    bindsym $mod+Shift+Escape exec $qs ipc call commandcenter open ":"

    # Quick settings — the bar's only widget, and the way into network,
    # bluetooth, notifications and battery
    bindsym $mod+n exec $qs ipc call popup toggle quicksettings
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
#
# Layout stuff:
#
    # Toggle whether the focused container splits side by side or stacked
    # top/bottom
    bindsym $mod+t layout toggle split

    # Switch the current container between tabbed and tiled
    bindsym $mod+w layout toggle tabbed split
    # Wrap the focused window in its own tabbed group (move others into it)
    bindsym $mod+Shift+w split v; layout tabbed

    # Make the current focus fullscreen
    bindsym $mod+Shift+f fullscreen
    bindsym $mod+f resize set width 100 ppt; resize set height 100 ppt
    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+t floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+Tab focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Send the focused window there / show (cycle) or hide scratchpad windows
    bindsym $mod+Shift+minus move scratchpad
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities:
#
    # Volume keys via wireplumber's wpctl (pactl isn't installed). Steps of
    # 1/16 to line up with the 16-segment OSD quickshell shows on change;
    # -l 1.0 caps at 100%.
    bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.0625-
    bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 0.0625+
    bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    # Brightness keys go through quickshell (logind SetBrightness, no
    # brightnessctl needed), which also shows the OSD.
    bindsym --locked XF86MonBrightnessDown exec $qs ipc call brightness down
    bindsym --locked XF86MonBrightnessUp exec $qs ipc call brightness up
    # Region screenshot -> satty for annotation (crop/arrows/blur/numbered
    # markers/text/undo); Enter saves + copies, see ~/.rice/satty for the
    # save location/theming. satty lives under ~/.local/bin, off sway's
    # PATH, hence the full paths.
    bindsym $mod+Shift+s exec ~/.local/bin/screenshot-region
    # Screen recording toggle: click a window, drag a region, or click a
    # monitor's bar for all of it; press again or click the bar's red REC
    # timer to stop. The mp4 lands in ~/Videos/Captures and on the
    # clipboard. See the script.
    bindsym $mod+Shift+r exec ~/.local/bin/screenrec

#
# Status Bar:
#
# quickshell (bar, popups, launcher, lock screen) from ~/.dots/quickshell.
# QML2_IMPORT_PATH makes `import quickshell` in its QML resolve to
# ~/.rice/quickshell's Colors singleton. `-n` skips spawning a duplicate if
# one's already running, so `exec_always` (needed to survive `$mod+Shift+c`
# reloads) doesn't pile up processes. qs-watchdog restarts it the same way.
exec_always env QML2_IMPORT_PATH=$HOME/.rice $HOME/.local/bin/quickshell -n
# qs-watchdog (restarts it if it hangs or crashes) runs from
# dots-session.target, see the session services above.

include /etc/sway/config.d/*
