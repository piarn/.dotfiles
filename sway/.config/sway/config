# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Cursor theme — without this, nothing sets XCURSOR_THEME, and wlroots
# can't resolve the custom-cursor requests GTK/Chromium issue on
# image/canvas hover, so the pointer just disappears there instead of
# falling back to a default arrow. This sets wlroots' own cursor manager;
# see ~/.config/environment.d/cursor.conf for the env vars GTK/Xwayland
# apps need too (must be set before sway starts, so it can't live here).
seat seat0 xcursor_theme Adwaita 24
# Your preferred terminal emulator — kitty is primary (live theme reload via
# reload_config_on_change), foot stays for quick/lightweight launches (see
# $mod+Shift+Return below) since it's the lighter of the two.
set $term kitty
set $term_fast foot
# Your preferred application launcher
#
# `qs` (quickshell) links against Qt's private ABI and must run against the
# exact Qt build it was compiled with — Qt 6.8.0 via aqtinstall under ~/Qt,
# not the system Qt package (see the exec_always below). Sway's own PATH has
# no ~/.local/bin to reach a wrapper for this, so every `qs` invocation below
# sets LD_LIBRARY_PATH itself. Bump the version if quickshell is rebuilt
# against a newer Qt.
set $qs env LD_LIBRARY_PATH=$HOME/Qt/6.8.0/gcc_64/lib qs
# Toggles the quickshell launcher panel (see ~/.dots/quickshell) via its
# IPC target, rather than spawning a new process each time.
set $menu exec $qs ipc call launcher toggle

### Theme (~/.rice)
include ~/.rice/sway/theme.conf

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output * bg ~/.rice/wallpaper.png fill
#
# Screen layout: ~/.rice/layouts/*.conf, switch manually with
# `apply-layout <name>` (e.g. apply-layout laptop) or let it auto-detect
# with `apply-layout --auto`. Rendered here by apply-layout from the
# active profile.
include ~/.rice/sway/outputs.conf
#
# Auto-switch the layout on dock/undock. `exec` only fires on sway's
# initial startup, not on reload, so this needs `exec_always` — the
# daemon takes an exclusive lock and exits immediately if another
# instance already holds it, so this stays deduplicated across reloads.
exec_always ~/.rice/bin/layout-watch
#
# Register a bluetooth pairing agent for the whole session — nothing else
# here does (no blueman/GNOME shell), so without this, bluetooth devices
# pair but drop right after connecting (see the script for why).
# exec_always is safe here too: the script exits immediately if one's
# already running.
exec_always ~/.local/bin/bluetooth-agent
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
#
# Lock (never suspend) after 10 minutes idle — the lock alone protects
# against someone walking up to an unattended session; an idle-triggered
# suspend risks losing unsaved work if something goes wrong on resume, so
# this deliberately doesn't do that (see also `output * power off`, left
# out for the same reason: it's one more thing that can fail to come back).
#
# `before-sleep` covers both an explicit suspend and a lid close — logind's
# default HandleLidSwitch=suspend routes a lid close through the same
# PrepareForSleep signal swayidle listens for, so one hook covers both
# without a separate lid-specific handler.
#
# Plain `exec` (not exec_always): swayidle should start once at sway's
# initial startup and keep running across `$mod+Shift+c` reloads, not get a
# second instance spawned on every reload the way exec_always would.
exec swayidle -w \
         timeout 600 '$qs ipc call lock lock' \
         before-sleep '$qs ipc call lock lock'

### Input configuration
#
# Example configuration:
#
#   input type:touchpad {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
#   input type:keyboard {
#       xkb_layout "eu"
#   }
#
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.

input "type:keyboard" {
    xkb_layout "lt"
    xkb_variant "us"
}

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term
    # Start the lightweight terminal (foot) for quick/throwaway launches
    bindsym $mod+Shift+Return exec $term_fast

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
    bindsym $mod+d exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file. Also kills quickshell first: its
    # exec_always line only spawns a new instance when none is running
    # (see the `-n` flag below), so a plain `reload` never picks up
    # changes to ~/.dots/quickshell's QML on its own — whether it does
    # depends on quickshell's own hot-reload, which isn't consistent
    # across versions/machines. Killing it here makes `$mod+Shift+c`
    # reliably reload quickshell too, everywhere.
    bindsym $mod+Shift+c exec $qs kill -n; reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

    # Lock the screen — quickshell's own session-lock surface (Toxic-themed,
    # blurred screenshot background), see
    # ~/.dots/quickshell/.config/quickshell/popups/LockScreen.qml
    bindsym $mod+Escape exec $qs ipc call lock lock

    # Power menu (lock/suspend/reboot/shutdown/logout) — the deliberate next
    # step up from Mod+Escape's direct lock
    bindsym $mod+Shift+Escape exec $qs ipc call powermenu toggle
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+Shift+f fullscreen
    bindsym $mod+f resize set width 100 ppt; resize set height 100 ppt
    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities:
#
    # Volume keys via wireplumber's wpctl (pactl isn't installed). Steps of
    # 1/16 to line up with the 16-segment OSD quickshell shows on change;
    # -l 1.0 caps at 100%.
    bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.0625-
    bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 0.0625+
    bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    # Brightness keys go through quickshell (logind SetBrightness, no
    # brightnessctl needed), which also shows the OSD.
    bindsym --locked XF86MonBrightnessDown exec $qs ipc call brightness down
    bindsym --locked XF86MonBrightnessUp exec $qs ipc call brightness up
    # Full screen, straight to satty for annotation (crop/arrows/blur/
    # numbered markers/text/undo) — Enter saves + copies, see
    # ~/.rice/satty for the save location/theming. satty lives under
    # ~/.local/bin (no apt/dnf package), which isn't on the PATH sway's
    # own exec runs with (see ~/.config/environment.d/path.conf) — call
    # it by full path so the bind doesn't depend on that being reloaded.
    bindsym Print exec grim - | ~/.local/bin/satty --filename -
    # Region screenshot: slurp for selection, then the same satty step.
    bindsym $mod+Shift+s exec grim -g "$(slurp)" - | ~/.local/bin/satty --filename -

#
# Status Bar:
#
# swaybar can't center a module (clock) or lay out network/battery — using
# quickshell instead (also provides the app launcher above), configured
# (Toxic theme included) in ~/.dots/quickshell. QML2_IMPORT_PATH makes
# `import quickshell` in its QML resolve to ~/.rice/quickshell's Colors
# singleton — see the comment atop ~/.rice/templates/quickshell/Colors.qml.tmpl.
# `-n` skips spawning a duplicate if one's already running, so `exec_always`
# (needed to survive `$mod+Shift+c` reloads) doesn't pile up processes.
# LD_LIBRARY_PATH is required because quickshell links against Qt's private
# ABI (see quickshell's BUILD.md) and must run against the exact Qt build it
# was compiled with — here Qt 6.8.0 via aqtinstall under ~/Qt, not the
# system Qt package. Sway's own PATH has no ~/.local/bin, so it can't reach
# a PATH-based wrapper for this; set the search path here instead. Bump the
# version below whenever quickshell is rebuilt against a newer Qt.
exec_always env QML2_IMPORT_PATH=$HOME/.rice LD_LIBRARY_PATH=$HOME/Qt/6.8.0/gcc_64/lib quickshell -n

include /etc/sway/config.d/*
