# Everything that runs for the length of a sway session, as systemd user
# services instead of sway `exec` lines: each one restarts if it dies, logs
# to `journalctl --user -u <name>`, and stops when sway exits. Started from
# sway's config (`systemctl --user restart dots-session.target`) once
# WAYLAND_DISPLAY/SWAYSOCK are imported into the systemd user environment.
#
# Its own target rather than Fedora's sway-session.target (sway-systemd),
# which Debian and Arch don't ship. BindsTo pulls in graphical-session.target
# the same way sway-session.target does, and stops this when it goes away.
[Unit]
Description=dots: sway session services
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
Wants=polkit-agent.service swayidle.service cliphist.service udiskie.service
Wants=bluetooth-agent.service layout-watch.service qs-watchdog.service
